---
const profile = {
  name: "Marcos",
  intro:
    "I’m an iOS developer based in Tokyo. I enjoy building clean, practical tools and polished user experiences.",
  focus: [
    "iOS / Swift / SwiftUI",
    "Performance & rendering pipelines (e.g., export to PDF)",
    "Product-minded engineering",
  ],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>About · {profile.name}</title>
    <style>
      :root { color-scheme: light dark; }
      body { margin: 0; font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial; }
      main { max-width: 880px; margin: 0 auto; padding: 56px 20px 80px; }
      .card { border: 1px solid rgba(127,127,127,.25); border-radius: 16px; padding: 22px; }
      .muted { opacity: .75; }
      a { text-decoration: none; }
      a:hover { text-decoration: underline; }
      ul { margin: 10px 0 0; padding-left: 18px; }
    </style>
  </head>
  <body>
    <main>
      <p><a href="/">← Home</a></p>

      <h1 style="margin: 10px 0 8px;">About</h1>
      <p class="muted" style="margin:0 0 18px;">{profile.intro}</p>

      <section class="card">
        <h2 style="margin:0 0 8px; font-size:20px;">Current focus</h2>
        <ul>
          {profile.focus.map((x) => <li>{x}</li>)}
        </ul>
      </section>
    </main>
  </body>
</html>
