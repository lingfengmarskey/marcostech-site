---
const project = {
  name: "GridWeave",
  tagline: "A pixel-based design tool for craft and pattern making.",
  status: "Available on the App Store",
  audience: [
    "Bead craft designers",
    "Pixel art & pattern makers",
    "Anyone who needs clean, printable grid designs",
  ],
  highlights: [
    "Convert images into precise pixel grids",
    "Edit individual pixels and add annotations",
    "Export clean, print-ready PDFs",
  ],
  philosophy: [
    "Designed for clarity, not clutter",
    "Focused on real craft workflows",
    "Fast, offline-friendly, and private by default",
  ],
  links: {
    appstore: "https://apps.apple.com/us/app/gridweave/id1569393152",
    support: "mailto:hello@marcostech.one",
    privacy: "/privacy",
  },
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{project.name} · Projects</title>
    <meta name="description" content={project.tagline} />
    <style>
      :root { color-scheme: light dark; }
      body {
        margin: 0;
        font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI,
          Roboto, Helvetica, Arial;
      }
      main {
        max-width: 880px;
        margin: 0 auto;
        padding: 56px 20px 80px;
      }
      h1 { margin: 10px 0 6px; font-size: 42px; letter-spacing: -0.02em; }
      h2 { margin: 0 0 8px; font-size: 20px; }
      p { line-height: 1.6; }
      .muted { opacity: 0.75; }
      .card {
        border: 1px solid rgba(127,127,127,.25);
        border-radius: 16px;
        padding: 22px;
      }
      .grid { display: grid; gap: 14px; }
      .row { display: flex; gap: 12px; flex-wrap: wrap; }
      .pill {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 999px;
        border: 1px solid rgba(127,127,127,.25);
        font-size: 12px;
      }
      a { text-decoration: none; }
      a:hover { text-decoration: underline; }
      ul { margin: 10px 0 0; padding-left: 18px; }

      /* ===============================
   Icon animation video styles
   =============================== */

.phoneFrame {
  width: clamp(260px, 40vw, 420px);
  aspect-ratio: 9 / 16;
  border-radius: 22px;
  overflow: hidden;
  background: rgba(127,127,127,.06);
  box-shadow: 0 12px 30px rgba(0,0,0,.12);
  margin: 0 auto;
}

.heroMedia {
  margin-top: 10px;
  margin-bottom: 8px;
}

.heroMedia .carousel {
  margin-top: 6px;
}


.vid {
  width: 100%;
  height: auto;                      /* ✅ 由视频原始比例决定高度 */
  display: block;
}


.carousel {
  position: relative;
  display: grid;
  align-items: center;
}

.track {
  display: flex;
  gap: 14px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none; /* Firefox */
  padding: 10px 6px 2px;
}
.track::-webkit-scrollbar { display: none; }

.slide {
  flex: 0 0 100%;              /* ✅ 每次占满一页 */
  scroll-snap-align: center;   /* ✅ 滑动后吸附到页 */
  display: flex;
  justify-content: center;     /* ✅ 卡片居中 */
}

.nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  border: 1px solid rgba(127,127,127,.25);
  background: rgba(0,0,0,.12);
  backdrop-filter: blur(8px);
  border-radius: 999px;
  width: 38px;
  height: 38px;
  cursor: pointer;
  user-select: none;
}
.nav:disabled { opacity: .35; cursor: default; }
.prev { left: 6px; }
.next { right: 6px; }

/* 手机上更自然：手势滑动，所以隐藏左右按钮 */
@media (max-width: 720px) {
  .nav { display: none; }
}

.dots {
  display: flex;
  gap: 8px;
  justify-content: center;
  margin-top: 8px;
}
.dot {
  width: 8px;
  height: 8px;
  border-radius: 999px;
  border: 1px solid rgba(127,127,127,.35);
  background: transparent;
  cursor: pointer;
  opacity: .8;
}
.dot[data-active="true"] {
  background: currentColor;
  opacity: 1;
}

.track { padding: 6px 0 0; }
.prev { left: 0; }
.next { right: 0; }

.mediaFrame {
  width: min(560px, 92vw);          /* ✅ 更像主视觉的大媒体 */
  margin: 0 auto;
  border-radius: 22px;
  overflow: hidden;
  background: rgba(127,127,127,.06);
  box-shadow: 0 12px 30px rgba(0,0,0,.12);
}



    </style>
  </head>

  <body>
    <main class="grid">
      <p><a href="/projects">← Projects</a></p>

      <!-- Header -->
      <header class="grid" style="gap:10px">
        <h1>{project.name}</h1>
        <p class="muted" style="font-size:18px">{project.tagline}</p>
        <div class="row">
          <span class="pill">{project.status}</span>
          <span class="pill">iOS App</span>
        </div>
      </header>

<section class="grie heroMedia">
  <div class="row" style="justify-content: space-between; align-items: baseline;">
    <h2 style="margin:0;">Turn pixels into patterns.</h2>
    <span class="muted" style="font-size: 11px; letter-spacing: .02em;">12s × 3</span>
  </div>


  <div class="carousel" aria-label="GridWeave icon animation videos">
    <button class="nav prev" type="button" aria-label="Previous animation">‹</button>

    <div class="track" id="gw-track">
      {[
        { src: "/media/gridweave/GridWeave2_1_3-1.mp4", label: "Icon animation 1" },
        { src: "/media/gridweave/GridWeave2_1_3-2.mp4", label: "Icon animation 2" },
        { src: "/media/gridweave/GridWeave2_1_3-3.mp4", label: "Icon animation 3" },
      ].map((v) => (
        <div class="slide">
          <div class="mediaFrame">
            <video
              class="vid"
              src={v.src}
              muted
              playsinline
              loop
              autoplay
              preload="metadata"
              aria-label={v.label}
            ></video>
          </div>
        </div>
      ))}
    </div>

    <button class="nav next" type="button" aria-label="Next animation">›</button>
  </div>

  <div class="dots" id="gw-dots" aria-label="Animation position">
    <button class="dot" type="button" aria-label="Go to animation 1"></button>
    <button class="dot" type="button" aria-label="Go to animation 2"></button>
    <button class="dot" type="button" aria-label="Go to animation 3"></button>
  </div>
</section>


      <!-- What it does -->
      <section class="card grid">
        <h2>What it does</h2>
        <ul>
          {project.highlights.map((x) => <li>{x}</li>)}
        </ul>
      </section>

      <!-- Who it's for -->
      <section class="card grid">
        <h2>Who it’s for</h2>
        <ul>
          {project.audience.map((x) => <li>{x}</li>)}
        </ul>
      </section>

      <!-- Design philosophy -->
      <section class="card grid">
        <h2>Design philosophy</h2>
        <ul>
          {project.philosophy.map((x) => <li>{x}</li>)}
        </ul>
      </section>

      <!-- Links -->
      <section class="card grid">
        <h2>Links</h2>
        <div class="grid">
          <div>
  <strong>App Store</strong>
  <div class="muted">
    <a href={project.links.appstore} target="_blank" rel="noopener">
      View on the App Store →
    </a>
  </div>
</div>
          <div>
            <strong>Support</strong>
            <div class="muted">
              <a href={project.links.support}>{project.links.support}</a>
            </div>
          </div>
          <div>
            <strong>Privacy Policy</strong>
            <div class="muted">
              <a href={project.links.privacy}>View privacy policy</a>
            </div>
          </div>
        </div>
      </section>

      <!-- Footer note -->
      <p class="muted">
        GridWeave is built and maintained independently, with a focus on
        long-term usability and stability.
      </p>
    </main>
    <script is:inline>
  (function () {
    const track = document.getElementById("gw-track");
    const dotsWrap = document.getElementById("gw-dots");
    if (!track || !dotsWrap) return;

    const slides = Array.from(track.querySelectorAll(".slide"));
    const videos = Array.from(track.querySelectorAll("video"));
    const dots = Array.from(dotsWrap.querySelectorAll(".dot"));
    const prev = track.parentElement.querySelector(".prev");
    const next = track.parentElement.querySelector(".next");

    let index = 0;

    function setActive(i, opts = { smooth: true }) {
      index = Math.max(0, Math.min(slides.length - 1, i));
      const left = slides[index].offsetLeft;
      track.scrollTo({ left, behavior: opts.smooth ? "smooth" : "auto" });

      dots.forEach((d, di) => d.setAttribute("data-active", di === index ? "true" : "false"));

      // Play only the active video (optional but nice)
      videos.forEach((v, vi) => {
        if (vi === index) v.play().catch(() => {});
        else { v.pause(); v.currentTime = 0; }
      });

      if (prev) prev.disabled = index === 0;
      if (next) next.disabled = index === slides.length - 1;
    }

    function nearestIndex() {
      const pos = track.scrollLeft;
      let best = 0;
      let bestDist = Infinity;
      slides.forEach((s, i) => {
        const d = Math.abs(s.offsetLeft - pos);
        if (d < bestDist) { bestDist = d; best = i; }
      });
      return best;
    }

    prev && prev.addEventListener("click", () => setActive(index - 1));
    next && next.addEventListener("click", () => setActive(index + 1));
    dots.forEach((d, i) => d.addEventListener("click", () => setActive(i)));

    let t = null;
    track.addEventListener("scroll", () => {
      clearTimeout(t);
      t = setTimeout(() => setActive(nearestIndex(), { smooth: true }), 120);
    }, { passive: true });

    setActive(0, { smooth: false });
  })();
</script>

  </body>
</html>
