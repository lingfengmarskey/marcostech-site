---
const site = {
  name: "Marcos",
  tagline: "iOS developer building thoughtful apps and tools.",
  location: "Tokyo, Japan",
  links: {
    projects: "/projects",
    about: "/about",
    github: "https://github.com/lingfengmarskey",
  },
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.name} · marcostech.one</title>
    <meta name="description" content={site.tagline} />
    <style>
      :root { color-scheme: light dark; }
      body { margin: 0; font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial; }
      main { max-width: 880px; margin: 0 auto; padding: 56px 20px 80px; }
      .card { border: 1px solid rgba(127,127,127,.25); border-radius: 16px; padding: 22px; }
      .muted { opacity: .75; }
      .grid { display: grid; gap: 14px; }
      a { text-decoration: none; }
      a:hover { text-decoration: underline; }
      .row { display:flex; gap:14px; flex-wrap: wrap; }
      .pill { display:inline-block; padding: 6px 10px; border-radius: 999px; border: 1px solid rgba(127,127,127,.25); }
    </style>
  </head>
  <body>
    <main class="grid">
      <header class="grid" style="gap:10px">
        <h1 style="margin:0; font-size:44px; letter-spacing:-0.02em;">
          {site.name}
        </h1>
        <p class="muted" style="margin:0; font-size:18px;">
          {site.tagline}
        </p>
        <div class="row">
          <span class="pill">{site.location}</span>
          <a class="pill" href={site.links.projects}>Projects</a>
          <a class="pill" href={site.links.about}>About</a>
        </div>
      </header>

      <section class="card grid">
        <h2 style="margin:0; font-size:20px;">Now</h2>
        <p class="muted" style="margin:0;">
          I build small, useful products and document what I learn along the way.
        </p>
      </section>

      <section class="card grid">
        <h2 style="margin:0; font-size:20px;">Featured</h2>
        <div class="grid">
          <div>
            <strong>GridWeave</strong>
            <div class="muted">Pixel-based design tool for craft & pattern making.</div>
            <div style="margin-top:8px;">
              <a href="/projects/gridweave">View project →</a>
            </div>
          </div>
        </div>
      </section>

      <footer class="muted" style="margin-top:6px;">
        <div class="row">
          <a href={site.links.github}>GitHub</a>
        </div>
      </footer>
    </main>
  </body>
</html>
