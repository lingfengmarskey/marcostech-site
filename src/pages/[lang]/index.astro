---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { normalizeLocale, t } from "../../i18n";

export function getStaticPaths() {
  return ["en", "ja", "zh"].map((lang) => ({ params: { lang } }));
}

const locale = normalizeLocale(Astro.params.lang);
const tr = t(locale);
---

<BaseLayout title={tr.home.seo.title} description={tr.home.seo.description}>
  <h1 style="margin: 6px 0 10px; font-size: 42px; letter-spacing: -0.02em;">
    {tr.home.hero.title}
  </h1>
  <p class="muted" style="font-size:18px; margin: 0 0 18px;">
    {tr.home.hero.subtitle}
  </p>

  <section style="margin-top: 18px; display:grid; gap: 14px;">
    {[
      { ...tr.home.blocks.projects, href: `/${locale}/projects` },
      { ...tr.home.blocks.notes, href: `/${locale}/notes` },
      { ...tr.home.blocks.labs, href: `/${locale}/labs` },
    ].map((b) => (
      <div style="border:1px solid rgba(127,127,127,.25); border-radius:16px; padding:18px 20px;">
        <strong>{b.title}</strong>
        <p class="muted" style="margin:8px 0 10px;">{b.body}</p>
        <a href={b.href}>{b.cta}</a>
      </div>
    ))}
  </section>
</BaseLayout>
