---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { normalizeLocale, t } from "../../i18n";

export function getStaticPaths() {
  return ["en", "ja", "zh"].map((lang) => ({ params: { lang } }));
}

const locale = normalizeLocale(Astro.params.lang);
const tr = t(locale);
---

<BaseLayout title={tr.about.seo.title} description={tr.about.seo.description}>
  <h1 style="margin: 6px 0 12px; font-size: 42px; letter-spacing: -0.02em;">
    {tr.about.title}
  </h1>

  <section style="border:1px solid rgba(127,127,127,.25); border-radius:16px; padding:22px;">
    <p class="muted" style="font-size:18px; margin:0 0 14px;">{tr.about.lead}</p>
    <p style="margin:0 0 14px; line-height:1.6;">{tr.about.p1}</p>
    <p style="margin:0 0 14px; line-height:1.6;">{tr.about.p2}</p>

    <p class="muted" style="margin-top: 18px;">
      <strong>{tr.about.contact.label}:</strong>
      <a href={`mailto:${tr.about.contact.value}`}>{tr.about.contact.value}</a>
    </p>
  </section>
</BaseLayout>
