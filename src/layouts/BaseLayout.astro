---
import LangSwitch from "../components/LangSwitch.astro";
import { site } from "../config/site";
import { normalizeLocale, t } from "../i18n";

const locale = normalizeLocale(Astro.params.lang);
const tr = t(locale);

const {
  title,
  description,
  ogImage = "/og.png",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).toString();
const og = new URL(ogImage, site.url).toString();

function isActive(prefix: string) {
  return Astro.url.pathname === prefix || Astro.url.pathname.startsWith(prefix + "/");
}
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />

    <link rel="icon" href="/favicon.svg" />
    <meta name="theme-color" content="#111111" />

    <style>
      :root { color-scheme: light dark; }
      body {
        margin: 0;
        font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;
      }
      main { max-width: 880px; margin: 0 auto; padding: 56px 20px 80px; }
      a { text-decoration: none; }
      a:hover { text-decoration: underline; }
      .muted { opacity: .75; }
      .topbar {
        display:flex; justify-content: space-between; align-items:center; gap: 12px;
        margin-bottom: 18px;
      }
      .nav { display:flex; gap: 14px; flex-wrap: wrap; font-size: 13px; opacity: .9; }
      .nav a[data-active="true"] { text-decoration: underline; font-weight: 600; }
    </style>
  </head>

  <body>
    <main>
      <div class="topbar">
        <nav class="nav" aria-label="Primary navigation">
          <a href={`/${locale}/`} data-active={isActive(`/${locale}`) ? "true" : "false"}>{tr.common.nav.home}</a>
          <a href={`/${locale}/projects`} data-active={isActive(`/${locale}/projects`) ? "true" : "false"}>{tr.common.nav.projects}</a>
          <a href={`/${locale}/notes`} data-active={isActive(`/${locale}/notes`) ? "true" : "false"}>{tr.common.nav.notes}</a>
          <a href={`/${locale}/labs`} data-active={isActive(`/${locale}/labs`) ? "true" : "false"}>{tr.common.nav.labs}</a>
          <a href={`/${locale}/about`} data-active={isActive(`/${locale}/about`) ? "true" : "false"}>{tr.common.nav.about}</a>
        </nav>
        <LangSwitch />
      </div>

      <slot />
    </main>
  </body>
</html>
